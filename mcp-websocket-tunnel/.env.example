# mcp-websocket-tunnel environment
# Copy to `.env` and fill in values you want to override. All vars are optional —
# defaults shown in comments come from server.ts.

# Port the tunnel HTTP/WS server listens on. Default: 4433
PORT=

# Public base URL advertised to clients in `session_created` / `session_resumed`.
# Used to build the per-session /mcp/<id> URL. Default: http://localhost:${PORT}
PUBLIC_BASE_URL=

# Max time (ms) to wait for the phone to answer a tunneled HTTP request.
# Lightning payments can be slow, so this is generous. Default: 180000
REQUEST_TIMEOUT_MS=

# Max request body size in bytes. Default: 10485760 (10 MiB)
MAX_BODY_BYTES=

# How long (ms) a disconnected session keeps its pending requests before they
# are dropped. The session itself (and its public URL) lives forever. Default: 60000
SESSION_GRACE_MS=

# SQLite file used to persist session ids across restarts. Default: tunnel.db
DB_PATH=

# Min interval (ms) between successive /connect attempts that create a NEW
# session from the same IP. Resume reconnects are never throttled. Default: 5000
CONNECT_RATE_LIMIT_MS=

# Optional TLS. If both are set, the server serves wss://. Leave both empty for plain http/ws.
TLS_CERT_PATH=
TLS_KEY_PATH=
