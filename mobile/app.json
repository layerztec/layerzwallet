{
  "expo": {
    "name": "Layerz Wallet",
    "slug": "layerzwallet",
    "version": "1.5.1",
    "orientation": "portrait",
    "scheme": ["bitcoin", "liquidnetwork", "layerzwallet"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.layerzwallet.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["bitcoin", "liquidnetwork", "layerzwallet"]
          }
        ]
      },
      "icon": "./assets/appicon.icon"
    },
    "android": {
      "permissions": ["android.permission.INTERNET", "android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO"],
      "package": "com.layerzwallet.mobile",
      "allowBackup": false,
      "icon": "./assets/images/android_512x512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android_512x512.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "bitcoin"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "liquidnetwork"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "layerzwallet"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan QR codes with addresses"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "assets/js/inpage-bridge.jstxt",
            "assets/animations/selfcustody.riv",
            "assets/animations/lightning.riv",
            "assets/animations/bars.riv",
            "assets/animations/swaps.riv",
            "assets/animations/liquid.riv",
            "assets/animations/nfts.riv",
            "assets/animations/oss.riv",
            "assets/animations/success.riv"
          ]
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "79e33289-7bd2-4ab4-8363-88ca65e99327"
      }
    },
    "owner": "layerztec"
  }
}
