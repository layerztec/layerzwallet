{
  "expo": {
    "name": "Layerz Wallet",
    "slug": "layerzwallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": ["bitcoin", "liquidnetwork", "layerzwallet"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.layerzwallet.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["bitcoin", "liquidnetwork", "layerzwallet"]
          }
        ]
      },
      "icon": {
        "dark": "./assets/images/ios-dark.png",
        "light": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA"],
      "package": "com.layerzwallet.mobile",
      "icon": "./assets/images/android_512x512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android_512x512.png",
        "backgroundColor": "#000000"
      },
      "launchMode": "singleInstance",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "bitcoin"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "liquidnetwork"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "layerzwallet"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "native",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "native",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan QR codes with addresses"
        }
      ],
      [
        "expo-asset",
        {
          "assets": ["assets/js/inpage-bridge.jstxt"]
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "79e33289-7bd2-4ab4-8363-88ca65e99327"
      }
    },
    "owner": "layerztec"
  }
}
