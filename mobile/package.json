{
  "name": "layerzwallet",
  "main": "./entry.js",
  "version": "1.3.0",
  "description": "Manage your Bitcoin across multiple Layer 2 solutions",
  "repository": {
    "type": "git",
    "url": "https://github.com/layerztec/layerzwallet.git"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "postinstall": "npx patch-package; node -e \"const fs = require('fs'); const easHash = process.env.EAS_BUILD_GIT_COMMIT_HASH || ''; console.log('EAS_BUILD_GIT_COMMIT_HASH:', easHash); fs.writeFileSync('git_commit_hash.json', JSON.stringify(easHash) + '\\n');\"",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "e2e": "maestro test .maestro/*",
    "unit": "vitest run ../shared/tests/unit-vi/ ./src/tests/unit-vi/ --silent",
    "integration": "vitest run ../shared/tests/integration-vi/ --silent",
    "lint": "prettier '**/*.{js,jsx,ts,tsx,json,css,scss,md,yml}' '../shared/**/*.{js,jsx,ts,tsx,json,css,scss,md,yml}' --config ./.prettierrc --check && tsc --noEmit && expo lint",
    "lint:write": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md,yml}' '../shared/**/*.{js,jsx,ts,tsx,json,css,scss,md,yml}' --config ./.prettierrc; expo lint --fix",
    "lint:fix": "npm run lint:write",
    "buildbridge": "cd scripts/inpage-bridge && ./build.sh"
  },
  "jest": {
    "preset": "jest-expo"
  },
