{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "env": {
        "EXAMPLE_ENV": "example value"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "credentialsSource": "remote"
      }
    },
    "simulator": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "development-simulator": {
      "extends": "simulator",
      "developmentClient": true,
      "distribution": "internal"
    },
    "mac-catalyst": {
      "extends": "base",
      "withoutCredentials": true,
      "ios": {
        "config": "mac-catalyst.yml",
        "buildConfiguration": "Release",
        "applicationArchivePath": "ios/build/Build/Products/Release-maccatalyst/LayerzWallet.app"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    },
    "production-apk": {
      "extends": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6745974808"
      }
    }
  }
}
