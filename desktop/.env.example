# Inlined at Vite build/dev-server start (not read at runtime by Electrobun).
# Same keys as mobile/ext. mobile/.env is also loaded automatically, and any
# EXPO_PUBLIC_* var is inlined (matching Expo/ext behavior).
EXPO_PUBLIC_BREEZ_API_KEY=

# Optional: enables the Garden Finance swap provider (else it is disabled).
EXPO_PUBLIC_GARDEN_APP_ID=

# Optional: Aptabase analytics app key (else analytics is disabled). Same key format as mobile.
EXPO_PUBLIC_APTABASE_KEY=
