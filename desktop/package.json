{
  "name": "layerzwallet",
  "version": "1.6.0",
  "description": "Layerz Wallet desktop app",
  "scripts": {
    "postinstall": "rm -f node_modules/silent-payments/tsconfig.json",
    "start": "vite build && electrobun dev",
    "dev": "vite build && electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build": "vite build && electrobun build --env=stable",
    "build:canary": "vite build && electrobun build --env=canary",
    "lint": "prettier '**/*.{js,jsx,ts,tsx,json,css,scss,md,yml}' --config ./.prettierrc --check && tsc --noEmit && eslint ./",
    "lint:write": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md,yml}' --config ./.prettierrc; eslint ./ --fix",
    "lint:fix": "npm run lint:write"
  },
  "dependencies": {
    "@aptabase/web": "^0.5.0",
    "@arkade-os/boltz-swap": "0.3.44",
    "@arkade-os/sdk": "0.4.39",
    "@bitcoinerlab/secp256k1": "1.2.0",
    "@breeztech/breez-sdk-liquid": "0.12.2",
    "@buildonspark/spark-sdk": "0.8.1",
    "@flashnet/sdk": "0.5.9",
    "@metamask/eth-sig-util": "8.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "1.6.3",
    "@paulmillr/qr": "0.3.0",
    "@spsina/bip47": "github:BlueWallet/bip47#df823454092a9993edeea11d663f8eb9a522a174",
    "@stacks/blockchain-api-client": "8.15.3",
    "@stacks/transactions": "7.4.0",
    "@stacks/wallet-sdk": "7.2.0",
    "assert": "2.1.0",
    "bignumber.js": "9.3.1",
    "bip21": "3.0.0",
    "bip32": "4.0.0",
    "bip39": "3.1.0",
    "bitcoinjs-lib": "7.0.1",
    "bitcoinjs-message": "2.2.0",
    "bolt11": "1.4.1",
    "browserify-cipher": "1.0.1",
    "browserify-zlib": "0.2.0",
    "bs58check": "2.1.2",
    "buffer": "6.0.3",
    "coinselect": "github:BlueWallet/coinselect#35f803875f37473e95e4207dd7ac8991c4ac7812",
    "crypto-browserify": "3.12.1",
    "ecpair": "3.0.1",
    "electrobun": "1.18.1",
    "ethers": "6.16.0",
    "events": "^3.3.0",
    "lucide-react": "0.564.0",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "7.13.0",
    "silent-payments": "github:BlueWallet/SilentPayments#59a0373254695dc2d1be2246aeeb4b1b83f91b28",
    "stream-browserify": "3.0.0",
    "stream-http": "3.2.0",
    "swr": "2.4.1",
    "timers-browserify": "2.0.12",
    "uint8array-extras": "1.5.0",
    "url": "0.11.4",
    "vm-browserify": "1.1.2",
    "wif": "2.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/bs58check": "^2.1.2",
    "@types/bun": "latest",
    "@types/create-hash": "1.2.6",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.10",
    "@types/wif": "^2.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.4.1",
    "prettier": "^3.7.4",
    "typescript": "5.9.3",
    "vite": "^6.0.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
